# ========================================================
# Portable Storage Hygiene & Git Ignore Rules
# ========================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt

# Large Trading Data Caches (Prevent Git bloat; data harvester saves locally)
data/cache/
data/raw/
*.csv.gz
*.parquet.tmp
*.sqlite-wal
*.sqlite-shm

# Node / JS
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / Editor Artifacts
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.bak
.vscode/
.idea/
*.swp

# Logs and Task Runs
logs/*.log
*.log
tools/*.log
